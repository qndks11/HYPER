<?xml version="1.0"?>
<sdf version="1.8">
  <model name="cantilevered_light">
    <static>false</static>
    
    <link name="base">
      <gravity>false</gravity>
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <pose>0 0 2.25 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.125</radius>
            <length>5</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 2.25 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.125</radius>
            <length>5</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <link name="cross_beam">
      <gravity>false</gravity>
      <pose>0 -2 4.4 1.5707 0 0</pose>
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0625</radius>
            <length>4.4</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0625</radius>
            <length>4.4</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <frame name="base_frame" attached_to="base">
    </frame>

    <frame name="cross_beam_frame">
      <pose relative_to="base_frame">0 0 4.4 1.5707 0 0</pose>
    </frame>

    <include>
      <name>traffic_light</name>
      <uri>model://gazebo_traffic_light</uri>
      <static>false</static>
      <pose relative_to="cross_beam_frame">0.0 -0.81 3.6 -1.5707 0 0</pose>
      <scale>0.5 0.5 0.5</scale>
    </include>
    
    <joint name="cross_beam_fixed" type="fixed" >
      <parent>base</parent>
      <child>cross_beam</child>
    </joint>

    <joint name="light_mount" type="fixed" >
      <parent>cross_beam</parent>
      <child>traffic_light::light_fixture</child>
    </joint>
  </model>
</sdf>
