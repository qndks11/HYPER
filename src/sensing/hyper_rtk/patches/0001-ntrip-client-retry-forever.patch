@@ -7,7 +7,10 @@ from .rtcm_parser import RTCMParser
 class NTRIPBase:
 
   # Public constants
-  DEFAULT_RECONNECT_ATTEMPT_MAX = 10
+  # 0 means "keep retrying forever". That is what we want on the car: a WiFi/LTE
+  # drop is normal mid-run, and the node giving up is worse than it reconnecting
+  # late, since nothing else restarts it.
+  DEFAULT_RECONNECT_ATTEMPT_MAX = 0
   DEFAULT_RECONNECT_ATEMPT_WAIT_SECONDS = 5
 
   def __init__(self, logerr=logging.error, logwarn=logging.warning, loginfo=logging.info, logdebug=logging.debug):
@@ -35,6 +38,10 @@ class NTRIPBase:
     self._shutdown = False
     self._connected = False
 
+    # Private reconnect state
+    self._reconnect_attempt_count = 0
+    self._next_reconnect_time = 0
+
     # Public reconnect info
     self.reconnect_attempt_max = self.DEFAULT_RECONNECT_ATTEMPT_MAX
     self.reconnect_attempt_wait_seconds = self.DEFAULT_RECONNECT_ATEMPT_WAIT_SECONDS
@@ -46,22 +53,49 @@ class NTRIPBase:
     raise NotImplementedError("Must override disconnect")
 
   def reconnect(self):
+    """Make at most one attempt to (re)establish the connection. Returns whether we are connected.
+
+    This never blocks and never gives up on its own, because it runs inside the
+    node's ROS callbacks. The original version looped here with time.sleep(),
+    which froze the node for the whole outage, and then raised once
+    reconnect_attempt_max attempts had failed, which killed the node -- so any
+    WiFi drop longer than reconnect_attempt_max * reconnect_attempt_wait_seconds
+    ended the RTCM stream permanently.
+
+    Callers just keep calling this (recv_rtcm does, at the rate of the node's
+    RTCM timer); attempts are throttled to one every
+    reconnect_attempt_wait_seconds. Set reconnect_attempt_max > 0 to restore the
+    old "give up and raise" behavior.
+    """
+    if self._shutdown:
+      return False
+
+    # First call after a drop: tear the dead connection down and retry immediately
     if self._connected:
-      while not self._shutdown:
-        self._reconnect_attempt_count += 1
-        self.disconnect()
-        connect_success = self.connect()
-        if not connect_success and self._reconnect_attempt_count < self.reconnect_attempt_max:
-          self._logerr('Reconnect failed. Retrying in {} seconds'.format(self.reconnect_attempt_wait_seconds))
-          time.sleep(self.reconnect_attempt_wait_seconds)
-        elif self._reconnect_attempt_count >= self.reconnect_attempt_max:
-          self._reconnect_attempt_count = 0
-          raise Exception("Reconnect was attempted {} times, but never succeeded".format(self._reconnect_attempt_count))
-        elif connect_success:
-          self._reconnect_attempt_count = 0
-          break
-    else:
-      self._logdebug('Reconnect called while not connected, ignoring')
+      self._reconnect_attempt_count = 0
+      self._next_reconnect_time = 0
+
+    now = time.time()
+    if now < self._next_reconnect_time:
+      return False
+    self._next_reconnect_time = now + self.reconnect_attempt_wait_seconds
+
+    self._reconnect_attempt_count += 1
+    self.disconnect()
+    if self.connect():
+      if self._reconnect_attempt_count > 1:
+        self._loginfo('Reconnected after {} attempts'.format(self._reconnect_attempt_count))
+      self._reconnect_attempt_count = 0
+      return True
+
+    if self.reconnect_attempt_max > 0 and self._reconnect_attempt_count >= self.reconnect_attempt_max:
+      attempts = self._reconnect_attempt_count
+      self._reconnect_attempt_count = 0
+      raise Exception("Reconnect was attempted {} times, but never succeeded".format(attempts))
+
+    self._logwarn('Connect attempt {} failed (network down?). Retrying in {} seconds'.format(
+      self._reconnect_attempt_count, self.reconnect_attempt_wait_seconds))
+    return False
 
   def send_nmea(self):
     raise NotImplementedError("Must override send_nmea")
