<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hyper_lidar</name>
  <version>0.0.0</version>
  <description>Real-hardware sensor driver launch/config (RPLidar, etc.). Not used in simulation -- auto_vehicle_gazebo's simulated LIDAR sensor publishes /scan there instead.</description>
  <maintainer email="workabotic@gmail.com">Lucas Mazzetto</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rplidar_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
