<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hyper_control</name>
  <version>0.0.0</version>
  <description>Ackermann steering vehicle: robot model (urdf) and control nodes (vehicle controller, joystick/keyboard teleop). Usable on real hardware and in simulation (see hyper_gazebo for sim-only launch/worlds; lane/object detection now live in hyper_lane_detection/hyper_object_detection under src/perception).</description>
  <maintainer email="workabotic@gmail.com">Lucas Mazzetto</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>libopencv-dev</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>