<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hyper_object_detection</name>
  <version>0.0.0</version>
  <description>YOLO-based object/traffic-light detection for HYPER.</description>
  <maintainer email="qndks11@gmail.com">kim</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>

  <!-- This package's perception.launch.py launches hyper_lane_detection (both backends) and
       reads its bev_real.yaml from that package's share directory. -->
  <exec_depend>hyper_lane_detection</exec_depend>

  <!-- lane_input_backend:=intra_process loads hyper_camera's ELP publisher into this launch
       file's container. -->
  <exec_depend>hyper_camera</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
