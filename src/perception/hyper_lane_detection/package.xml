<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hyper_lane_detection</name>
  <version>0.0.0</version>
  <description>Camera-based lane and stop-line detection (bird's-eye view, OpenCV) for HYPER.</description>
  <maintainer email="qndks11@gmail.com">kim</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>ament_index_cpp</depend>
  <depend>camera_calibration_parsers</depend>
  <depend>libopencv-dev</depend>

  <!-- input_backend:=direct_usb loads its ELP calibration file from this package's share
       directory at runtime (ament_index_cpp::get_package_share_directory), not a build/link
       dependency. -->
  <exec_depend>hyper_camera</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
