      <name>construction_cone_15</name> 
      <pose>5.0477 -30.1759 0.0000 0.0 0.0 1.21898</pose>
    </include>
    
    <include>
      <uri>model://construction_cone</uri>
      <name>construction_cone_16</name> 
      <pose>5.1722 -29.8368 0.0000 0.0 0.0 1.21898</pose>
    </include>

    <include>
      <uri>model://construction_cone</uri>
      <name>construction_cone_6</name> 
      <pose>28.6561 -13.3555 0.0000 0.0 0.0 1.21898</pose>
    </include>

    <include>
      <uri>model://construction_cone</uri>
      <name>construction_cone_7</name> 
      <pose>28.2321 -13.1999 0.0000 0.0 0.0 1.21898</pose>
    </include>

    <include>
      <uri>model://construction_cone</uri>
      <name>construction_cone_8</name> 
      <pose>27.8082 -13.0443 0.0000 0.0 0.0 1.21898</pose>
    </include>

    <include>
      <uri>model://construction_cone</uri>
      <name>construction_cone_9</name> 
      <pose>27.3843 -12.8886 0.0000 0.0 0.0 1.21898</pose>
    </include>

    <include>
      <uri>model://construction_cone</uri>
      <name>construction_cone_10</name> 
      <pose>26.9603 -12.7330 0.0000 0.0 0.0 1.21898</pose>
    </include>

    <include>
