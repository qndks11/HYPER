    <!-- 코스 전체를 용인 트랙의 map 좌표로 옮기는 자리입니다. real_course.png는
         실제 항공사진이라 회전/스케일 보정이 필요 없고, 이 자리는 waypoint
         studio의 align 도구로 구한 meshes/real_course.align.yaml의 값을 그대로
         씁니다 (center_x, center_y, rotation_deg 0). -->
    <include>
      <uri>model://driving_course</uri>
      <name>driving_course</name>
      <pose>-5.1645 -5.2907 0 0 0 0</pose>
    </include>

    <!-- Acceleration path obstacles.
         Path runs from accel_start (-53.250, -26.930) to accel_end (2.155, -49.931)
         (see hyper_planner/mission/mission_track.yaml); heading along the path is -0.3934 rad. -->

    <!-- Pedestrian at the midpoint of the acceleration path, facing oncoming traffic.
         person_standing has an 80 kg inertial and no <static> of its own, so without
         this override the car knocks it over instead of it acting as a fixed obstacle. -->
    <include>
      <uri>model://person_standing</uri>
      <name>accel_pedestrian</name>
      <static>true</static>
      <pose>-27.1974 -37.2906 0.0000 0.0 0.0 2.78978</pose>
    </include>

    <!-- Two parked vehicles along the acceleration path. -->
    <include>
      <uri>model://hatchback</uri>
      <name>accel_car_1</name>
      <pose>-31.5019 -11.5115 0.0000 0.0 0.0 -0.0063</pose>
    </include>

    <include>
      <uri>model://suv</uri>
      <name>accel_car_2</name>
      <pose>-42.118 -8.4922 0.0000 0.0 0.0 -0.8541</pose>
    </include>

    <include>
      <uri>model://cantilevered_light</uri>
      <name>cantilevered_light_1</name>
      <pose>-11.1869 -15.4033 0.0000 0 0 1.21898</pose>
      <plugin filename="libTrafficLightPlugin.so" name="hyper_gazebo::TrafficLightPlugin">
        <phase duration="6.0" color="red"/>
        <phase duration="4.0" color="red"/>
        <phase duration="6.0" color="green"/>
        <phase duration="4.0" color="yellow"/>
        <phase duration="6.0" color="red"/>
        <phase duration="4.0" color="red"/>
      </plugin>
    </include>

    <include>
      <uri>model://cantilevered_light</uri>
      <name>cantilevered_light_2</name>
      <pose>0.6208 -16.9957 0.0000 0 0 2.78968</pose>
      <plugin filename="libTrafficLightPlugin.so" name="hyper_gazebo::TrafficLightPlugin">
        <phase duration="6.0" color="red"/>
        <phase duration="4.0" color="red"/>
        <phase duration="6.0" color="red"/>
        <phase duration="4.0" color="red"/>
        <phase duration="6.0" color="green"/>
        <phase duration="4.0" color="yellow"/>
      </plugin>
    </include>

    <include>
      <uri>model://cantilevered_light</uri>
      <name>cantilevered_light_3</name>
      <pose>5.8233 -1.5390 0.0000 0 0 4.36058</pose>
      <plugin filename="libTrafficLightPlugin.so" name="hyper_gazebo::TrafficLightPlugin">
        <phase duration="6.0" color="right_turn"/>
        <phase duration="4.0" color="yellow"/>
        <phase duration="6.0" color="red"/>
        <phase duration="4.0" color="red"/>
        <phase duration="6.0" color="red"/>
        <phase duration="4.0" color="red"/>
      </plugin>
    </include>

    <include>
      <uri>model://cantilevered_light</uri>
      <name>cantilevered_light_4</name>
      <pose>-12.8962 1.3013 0.0000 0 0 5.93136</pose>
      <plugin filename="libTrafficLightPlugin.so" name="hyper_gazebo::TrafficLightPlugin">
        <phase duration="1.0" color="yellow"/>
      </plugin>
    </include>

    <!-- Lane control sign prototypes, mounted ahead of the vehicle spawn,
         facing back toward the car (panel normal along -Y). -->
    <include>
      <uri>model://lane_sign_arrow</uri>
      <name>lane_sign_arrow_1</name>
      <pose>28.0909 0.3732 3.2269 0 0 2.74008</pose>
    </include>

    <include>
      <uri>model://lane_sign_x</uri>
      <name>lane_sign_x_1</name>
      <pose>26.9800 -2.3833 3.1832 0 0 2.74008</pose>
    </include>

    <!-- 이 값은 hyper_localization/config/datums.yaml의 `track` 항목과 **반드시**
         같아야 합니다. gz navsat 센서는 월드 좌표에서 위경도를 만들고
         navsat_transform은 datum 위경도에서 map 원점을 잡으므로, 둘이 어긋나면
         map != Gazebo 월드가 되어 웨이포인트/미션 좌표가 통째로 밀립니다.
         heading_deg는 0으로 둡니다: map X=East, Y=North (datums.yaml 참고). -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.2887947</latitude_deg>
      <longitude_deg>127.1072418</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
  </world>
