<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="driving_course">
    <static>true</static>
    <link name="base">

      <!-- flat photo ground (roads, markings, crosswalks): 74 x 100.8 m, 3 m lanes -->
      <visual name="ground_visual">
        <geometry>
          <mesh><uri>model://driving_course/meshes/ground.obj</uri></mesh>
        </geometry>
      </visual>
      <collision name="ground_collision">
        <geometry>
          <plane><normal>0 0 1</normal><size>74 100.8</size></plane>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>

      <!-- smooth hill over the blue(up)/red(down) rectangles marked in meshes/elevation.png:
           peak 1.5 m at the blue/red seam, tangent-flat at both ends, steep (vertical)
           side walls at the road edges. See build_hill.py for the generator. -->
      <visual name="hill_visual">
        <geometry>
          <mesh><uri>model://driving_course/meshes/hill.obj</uri></mesh>
        </geometry>
      </visual>
      <collision name="hill_collision">
        <geometry>
          <mesh><uri>model://driving_course/meshes/hill.obj</uri></mesh>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>

    </link>
  </model>
</sdf>
