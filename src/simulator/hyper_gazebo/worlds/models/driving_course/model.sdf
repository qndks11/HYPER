<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="driving_course">
    <static>true</static>
    <link name="base">

      <!-- flat aerial-photo ground (roads, markings, crosswalks): 121.2454 x 100.8239 m.
           Textured directly with meshes/real_course.png, a true-scale aerial photo of
           the track that's already registered to the map frame (see
           meshes/real_course.align.yaml, produced by the waypoint studio's align tool).
           No similarity transform is baked into this mesh - the include <pose> in
           track.world places it straight from that alignment (rotation 0). -->
      <visual name="ground_visual">
        <geometry>
          <mesh><uri>model://driving_course/meshes/ground.obj</uri></mesh>
        </geometry>
      </visual>
      <collision name="ground_collision">
        <geometry>
          <plane><normal>0 0 1</normal><size>121.2454 100.8239</size></plane>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>

    </link>
  </model>
</sdf>
