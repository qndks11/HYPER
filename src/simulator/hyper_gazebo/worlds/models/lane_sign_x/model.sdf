<?xml version="1.0"?>
<sdf version="1.7">
  <model name="lane_sign_x">
    <static>true</static>

    <!-- Panel sits with its face along +X. Origin is at the panel centre;
         raise the model in the world with <pose> to mount it overhead. -->
    <link name="panel">
      <gravity>false</gravity>

      <!-- 1 x 1 m black background square, 5 cm thick. -->
      <visual name="background">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 1.0 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- Red X, built from two crossed diagonal bars standing proud of the panel. -->
      <visual name="stroke_a">
        <pose>0.03 0 0 0.7854 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.18 1.28</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0 0 1</ambient>
          <diffuse>0.9 0 0 1</diffuse>
          <specular>0 0 0 1</specular>
          <emissive>0.9 0 0 1</emissive>
        </material>
      </visual>

      <visual name="stroke_b">
        <pose>0.03 0 0 -0.7854 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.18 1.28</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0 0 1</ambient>
          <diffuse>0.9 0 0 1</diffuse>
          <specular>0 0 0 1</specular>
          <emissive>0.9 0 0 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
