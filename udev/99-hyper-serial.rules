# ---------------------------------------------------------------------------
# 1) Ardusimple simpleRTK2B (u-blox ZED-F9P) x2 -- moving-base 헤딩용 base+rover.
#    USB로 직접 CDC-ACM으로 잡힌다. 두 보드가 idVendor/idProduct까지 완전히 같아서
#    (1546:01a9) 이 값만으로는 구분이 안 된다. 이 보드는 ATTRS{serial}도 안 낸다
#    (udevadm info -a로 보면 첫 ATTRS{serial}이 PCI 호스트 컨트롤러(0000:00:14.0)
#    것이지 이 장치 것이 아니다) -- 그래서 시리얼 대신 물리 USB 포트(KERNELS)로
#    고정한다. 즉 "이 컴퓨터의 이 USB 포트에 꽂힌 보드가 base/rover다"라는
#    약속이 되므로, 실차에서 그 포트에 계속 꽂아 두거나 포트가 바뀌면 아래 값도
#    다시 뽑아야 한다:
#      udevadm info -a -n /dev/ttyACM0 | grep -m1 'KERNELS=="[0-9]'
#    (또는 ./udev/show-serial-ids.sh의 "USB port" 열) -- 뒤쪽 안테나 보드를 base,
#    앞쪽을 rover로 정한다. base=1-3, rover=1-2는 이 차의 USB 포트를 뽑아서 확인한
#    값이다 -- 다른 컴퓨터/포트 배치로 바뀌면 위 방법으로 다시 뽑아 채울 것.
# ---------------------------------------------------------------------------
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", KERNELS=="1-3", SYMLINK+="tty_ublox_base", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", KERNELS=="1-2", SYMLINK+="tty_ublox_rover", MODE="0666"

# ---------------------------------------------------------------------------
# 2) EBIMU-9DOFV5 USB-UART 어댑터 -- 모듈 자체엔 USB가 없고 어댑터로 물린다
#    (hyper_ebimu/README.md의 배선표). 쓰는 어댑터 칩의 줄만 남기고 나머지는 지운다.
#    기본값은 CP210x를 켜 둔 상태다 -- Arduino(CH340)와 겹치지 않기 때문이다.
# ---------------------------------------------------------------------------
# CP210x (Silicon Labs)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="tty_ebimu", MODE="0666"
# FTDI FT232R
#SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", SYMLINK+="tty_ebimu", MODE="0666"
# CH340 -- Arduino 보드와 같은 칩이므로 반드시 serial 또는 KERNELS를 같이 걸 것
#SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-1.3", SYMLINK+="tty_ebimu", MODE="0666"

# ---------------------------------------------------------------------------
# 3) Arduino 인터페이스 보드 (CH340) -- /velocity + /steering_angle을 넘기는 링크.
#    lsusb에서 "QinHeng Electronics CH340"으로 보인다.
# ---------------------------------------------------------------------------
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="tty_arduino", MODE="0666"

# ---------------------------------------------------------------------------
# 4) Logitech C920 USB 카메라 -- /dev/video0으로 잡히는 장치.
# ---------------------------------------------------------------------------
