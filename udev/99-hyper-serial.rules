# ---------------------------------------------------------------------------
# 1) Ardusimple simpleRTK2B (u-blox ZED-F9P) -- USB로 직접 CDC-ACM으로 잡힌다.
#    이 이름은 rtk.launch.py가 이미 쓰고 있던 이름이라 그대로 유지한다.
# ---------------------------------------------------------------------------
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", SYMLINK+="tty_Ardusimple", MODE="0666"

# ---------------------------------------------------------------------------
# 2) EBIMU-9DOFV5 USB-UART 어댑터 -- 모듈 자체엔 USB가 없고 어댑터로 물린다
#    (hyper_ebimu/README.md의 배선표). 쓰는 어댑터 칩의 줄만 남기고 나머지는 지운다.
#    기본값은 CP210x를 켜 둔 상태다 -- Arduino(CH340)와 겹치지 않기 때문이다.
# ---------------------------------------------------------------------------
# CP210x (Silicon Labs)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="tty_ebimu", MODE="0666"
# FTDI FT232R
#SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", SYMLINK+="tty_ebimu", MODE="0666"
# CH340 -- Arduino 보드와 같은 칩이므로 반드시 serial 또는 KERNELS를 같이 걸 것
#SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-1.3", SYMLINK+="tty_ebimu", MODE="0666"

# ---------------------------------------------------------------------------
# 3) Arduino 인터페이스 보드 (CH340) -- /velocity + /steering_angle을 넘기는 링크.
#    lsusb에서 "QinHeng Electronics CH340"으로 보인다.
# ---------------------------------------------------------------------------
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="tty_arduino", MODE="0666"

# ---------------------------------------------------------------------------
# 4) Logitech C920 USB 카메라 -- /dev/video0으로 잡히는 장치.
# ---------------------------------------------------------------------------
