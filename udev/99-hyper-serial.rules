# ---------------------------------------------------------------------------
# 1) Ardusimple simpleRTK2B (u-blox ZED-F9P) x2 -- moving-base 헤딩용 base+rover.
#    USB로 직접 CDC-ACM으로 잡힌다. 두 보드는 idVendor/idProduct가 (1546:01a9)로
#    완전히 같고, 공장 출하 상태에서는 USB iSerialNumber 디스크립터를 아예 내지
#    않는다 -- 그래서 예전에는 물리 USB 포트(KERNELS)로 고정할 수밖에 없었다.
#
#    지금은 두 보드에 USB 시리얼 문자열을 직접 써 넣어서 구분한다. ZED-F9P 설정
#    인터페이스에 CFG-USB-SERIAL_NO_STR0..3 (키 0x50650015..0x50650018, 8바이트
#    x 4 = 32바이트)이 있고, 값을 넣고 Flash 레이어에 저장한 뒤 보드를 재열거
#    (UBX-CFG-RST 또는 물리적으로 뺐다 꽂기)하면 리눅스가 ATTRS{serial}로 읽는다.
#    이 차의 두 보드에는 이미 아래 값이 Flash에 기록돼 있다:
#
#      HYPER-GNSS-BASE   (칩 ID a4:4d:f2:0b:9d, 뒤쪽 안테나)
#      HYPER-GNSS-ROVER  (칩 ID db:4c:2a:8c:9b, 앞쪽 안테나)
#
#    칩 ID는 UBX-SEC-UNIQID로 읽는 실리콘 고유값이라, 시리얼 문자열이 지워지거나
#    잘못 들어가도 어느 보드인지 항상 확인할 수 있다. 읽기/다시 쓰기는:
#
#      ./udev/ublox-serial.py --list                    # 꽂힌 보드의 칩 ID/시리얼
#      ./udev/ublox-serial.py /dev/ttyACM0 HYPER-GNSS-BASE --reset
#
#    포트 위치와 무관하므로 어느 USB 포트에 꽂아도 되고, 보드를 교체하면 새 보드에
#    같은 문자열을 써 넣기만 하면 된다 -- KERNELS 값을 다시 뽑을 필요가 없다.
# ---------------------------------------------------------------------------
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", ATTRS{serial}=="HYPER-GNSS-BASE", SYMLINK+="tty_ublox_base", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", ATTRS{serial}=="HYPER-GNSS-ROVER", SYMLINK+="tty_ublox_rover", MODE="0666"

# ---------------------------------------------------------------------------
# 2) EBIMU-9DOFV5 USB-UART 어댑터 -- 모듈 자체엔 USB가 없고 어댑터로 물린다
#    (hyper_ebimu/README.md의 배선표). 쓰는 어댑터 칩의 줄만 남기고 나머지는 지운다.
#    기본값은 CP210x를 켜 둔 상태다 -- Arduino(CH340)와 겹치지 않기 때문이다.
# ---------------------------------------------------------------------------
# CP210x (Silicon Labs)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="tty_ebimu", MODE="0666"
# FTDI FT232R
#SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", SYMLINK+="tty_ebimu", MODE="0666"
# CH340 -- Arduino 보드와 같은 칩이므로 반드시 serial 또는 KERNELS를 같이 걸 것
#SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-1.3", SYMLINK+="tty_ebimu", MODE="0666"

# ---------------------------------------------------------------------------
# 3) Arduino 인터페이스 보드 (CH340) -- /velocity + /steering_angle을 넘기는 링크.
#    lsusb에서 "QinHeng Electronics CH340"으로 보인다.
# ---------------------------------------------------------------------------
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="tty_arduino", MODE="0666"

# ---------------------------------------------------------------------------
# 4) Logitech C920 USB 카메라 -- /dev/video0으로 잡히는 장치.
# ---------------------------------------------------------------------------
