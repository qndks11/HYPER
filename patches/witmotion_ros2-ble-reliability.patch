+bool WITMotionNode::interruptibleSleep(double seconds)
+{
+  const auto deadline =
+    std::chrono::steady_clock::now() + std::chrono::duration<double>(seconds);
+  while (running_ && std::chrono::steady_clock::now() < deadline) {
+    std::this_thread::sleep_for(kPollInterval);
+  }
+  return running_;
+}
+
+bool WITMotionNode::matches(SimpleBLE::Peripheral & peripheral) const
+{
+  if (!device_address_.empty()) {
+    // BlueZ reports addresses upper-case; accept a lower-case device_address
+    // in the params file rather than silently never matching.
+    const std::string address = peripheral.address();
+    return std::equal(
+      address.begin(), address.end(), device_address_.begin(), device_address_.end(),
+      [](unsigned char a, unsigned char b) {return std::toupper(a) == std::toupper(b);});
+  }
+  return peripheral.identifier().find(device_name_) != std::string::npos;
+}
