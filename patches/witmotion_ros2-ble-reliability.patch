 void WITMotionNode::onNotify(const SimpleBLE::ByteArray & payload)
+{
+  // Runs on SimpleBLE's internal D-Bus thread, not a ROS executor thread. An
+  // exception escaping from here unwinds into a thread with no handler and
+  // takes the whole process down via std::terminate -- during shutdown, or on
+  // any publish error, the node would simply vanish. Nothing may propagate out.
+  try {
+    onNotifyImpl(payload);
+  } catch (const std::exception & exc) {
+    RCLCPP_WARN_THROTTLE(
+      get_logger(), *get_clock(), 5000, "Dropping IMU notification: %s", exc.what());
+  } catch (...) {
+    RCLCPP_WARN_THROTTLE(
+      get_logger(), *get_clock(), 5000, "Dropping IMU notification: unknown error");
+  }
+}
+
+void WITMotionNode::onNotifyImpl(const SimpleBLE::ByteArray & payload)
 {
   std::vector<std::vector<uint8_t>> frames;
   {
