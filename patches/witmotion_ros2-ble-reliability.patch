+bool WITMotionNode::connectWithRetry(SimpleBLE::Peripheral & peripheral)
+{
+  for (int attempt = 1; running_ && attempt <= connect_attempts_; ++attempt) {
+    try {
+      // A link left open by a previous run -- one killed before its destructor
+      // could disconnect, say -- keeps the sensor from advertising and blocks a
+      // fresh connect. Drop it so this attempt starts from a clean link.
+      if (peripheral.is_connected()) {
+        RCLCPP_WARN(get_logger(), "IMU link already open (stale); dropping it first");
+        peripheral.disconnect();
+        if (!interruptibleSleep(connect_retry_wait_sec_)) {
+          return false;
+        }
+      }
+      peripheral.connect();
+      return true;
+    } catch (const std::exception & exc) {
+      RCLCPP_WARN(
+        get_logger(), "Connect attempt %d/%d failed: %s",
+        attempt, connect_attempts_, exc.what());
+    }
+    if (attempt < connect_attempts_ && !interruptibleSleep(connect_retry_wait_sec_)) {
+      return false;
+    }
+  }
+  return false;
 }
 
